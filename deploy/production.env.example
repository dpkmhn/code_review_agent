# Copy to production.env on the Linux API host; chmod 600 production.env.
PUBLIC_HOST=reviews.example.com
WORKSPACE_USER=reviewer
# Single quotes preserve bcrypt's dollar signs in Compose env files.
WORKSPACE_PASSWORD_HASH='$2a$14$REPLACE_WITH_CADDY_HASH'
API_ACCESS_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
# Separate admin and application passwords. Use random hex to avoid URL encoding.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
REVIEW_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql://review_user:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/code_reviews
# Leave disabled until the dedicated Linux worker passes its smoke test.
SANDBOX_ENABLED=false
SANDBOX_WORKER_URL=
SANDBOX_WORKER_TOKEN=
